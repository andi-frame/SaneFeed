    <!-- Disclosure -->
    <string name="disclosure_title">Before you turn it on</string>
    <string name="disclosure_intro">SaneFeed uses Android\'s accessibility service to see what X and Instagram show on screen. Android requires your permission for this.</string>
    <string name="disclosure_reads_title">What it reads</string>
    <string name="disclosure_reads_body">Account handles on posts, where posts are on screen, and whether a Reels or video screen is open. Only inside X and Instagram. It doesn\'t read messages or anything you type.</string>
    <string name="disclosure_does_title">What it does</string>
    <string name="disclosure_does_body">Covers posts from accounts on your buzzer lists, covers the Reels and video tabs, counts posts you\'ve seen today, and shows a screen when you reach your limit. It presses Back when Reels open and Home when you tap Leave app.</string>
    <string name="disclosure_network_title">What leaves your phone</string>
    <string name="disclosure_network_body">Nothing you see or do. The app only downloads the buzzer list from the server. Reports and votes are sent only when you submit them, with a random install ID and no account.</string>
    <string name="disclosure_control_title">Turning it off</string>
    <string name="disclosure_control_body">Turn SaneFeed off at any time in Settings > Accessibility. Counts and your blocklist stay on this phone.</string>
    <string name="disclosure_agree">Agree and open Accessibility settings</string>
    <string name="disclosure_decline">Not now</string>

