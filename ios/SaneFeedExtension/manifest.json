{
  "manifest_version": 3,
  "name": "SaneFeed",
  "version": "1.0.0",
  "description": "Removes reels, caps posts per day, and hides buzzer accounts on X and Instagram.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "action": {
    "default_title": "SaneFeed",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://api.sanefeed.byhan.id/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content/core.js", "content/sites/x.js", "content/main.js"],
      "css": ["content/content.css", "content/sites/x.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content/core.js", "content/sites/instagram.js", "content/main.js"],
      "css": ["content/content.css", "content/sites/instagram.css"],
      "run_at": "document_idle"
    }
  ]
}
